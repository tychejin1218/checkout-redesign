<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.checkout.legacy.mapper.LegacyConnectionMapper">
  <select id="countGoods" resultType="int">
    SELECT COUNT(*) FROM TB_GOODS
  </select>

  <select id="countOrders" resultType="int">
    SELECT COUNT(*) FROM TB_ORDER
  </select>

  <select id="countTablesByName" resultType="int">
    SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = #{tableName}
  </select>

  <select id="findStockQty" resultType="java.lang.Integer">
    SELECT STOCK_QTY FROM TB_GOODS WHERE GOODS_CD = #{goodsCd}
  </select>

  <update id="updateStockQty">
    UPDATE TB_GOODS SET STOCK_QTY = #{stockQty} WHERE GOODS_CD = #{goodsCd}
  </update>
</mapper>
