<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.checkout.legacy.mapper.LegacyMemberMapper">
  <select id="countActiveMember" resultType="int">
    SELECT COUNT(*) FROM TB_MEMBER WHERE MBR_NO = #{mbrNo} AND USE_YN = 'Y'
  </select>
</mapper>
